# Week 2: real threat-intel lookups. Each is entirely optional and
# independent — Hookline runs fine with zero, one, two, or all three set.
# Whichever are missing just get skipped, with that noted in the
# response's evidence trail rather than silently ignored.
#
# Copy this file to .env and fill in whichever keys you have:
#   cp .env.example .env

# Google Safe Browsing — free, non-commercial use only.
# Enable the API + create a key: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal — free tier, rate-limited (per-minute/day/month).
# Sign up: https://www.virustotal.com/gui/join-us
# Then copy your key from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# PhishTank — free, maintained by Cisco Talos.
# Register and generate an app key at: https://phishtank.net
PHISHTANK_API_KEY=

# Week 3: live domain-age (RDAP) and TLS certificate checks. Off by
# default — unlike the threat-intel sources above, these connect
# directly to whatever host a submitted URL points at (see
# app/enrichment/tls_client.py's SSRF guard), so they need an explicit
# opt-in rather than just an API key.
ENABLE_LIVE_ENRICHMENT=false
